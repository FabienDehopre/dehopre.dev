{
  "mcpServers": {
    "nx": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "nx-mcp@latest"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "eslint": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "@eslint/mcp@latest"
      ],
      "env": {}
    },
    "angular-cli": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "@angular/cli@latest",
        "mcp"
      ],
      "env": {}
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "nx",
        "mcp"
      ]
    },
    "spartan-ui": {
      "type": "stdio",
      "command": "pnx",
      "args": [
        "-y",
        "@spartan-ng/mcp"
      ]
    }
  }
}
